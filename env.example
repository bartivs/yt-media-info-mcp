# yt-media-info MCP configuration
# Copy this file to .env and customize. .env is gitignored.
# .env.local can be used for per-machine secrets (also gitignored, overrides .env).

# Transport: 0 = stdio (Claude Desktop), 1 = SSE (Express HTTP server)
ENABLE_SSE=0

# HTTP server (SSE mode only)
YT_MEDIA_INFO_PORT=9423
YT_MEDIA_INFO_HOST=0.0.0.0

# Python service base URL (called by the Node server over the Docker network)
YT_MEDIA_INFO_SERVICE_URL=http://yt-media-info-service:8000

# Optional bearer API key for the server's HTTP endpoints (/api, /sse, /messages).
# Empty = no auth. stdio mode is never subject to API key auth.
YT_MEDIA_INFO_API_KEY=

# Optional yt-dlp site auth (defaults for extract_info / get_transcript; per-call overrides win)
YT_MEDIA_INFO_USERNAME=
YT_MEDIA_INFO_PASSWORD=

# Winston log level: error, warn, info, debug
LOG_LEVEL=info
